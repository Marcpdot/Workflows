{
  "name": "orchestrator",
  "version": "0.1.0",
  "description": "Minimal modular orchestrator — Ollama (local) + Grok (frontier)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "serve": "tsx src/integration/serverMain.ts",
    "ui": "tsx src/ui/web/main.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/run-eval.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@workflows/eval": "file:../packages/eval",
    "better-sqlite3": "^13.0.2"
  }
}
