# --- Local (Ollama CLI) ---
# Use a small model on weak machines (laptop). Override anytime.
OLLAMA_MODEL=llama3.2:3b
# Optional: path to ollama binary if not on PATH
# OLLAMA_BIN=ollama

# --- Frontier (xAI Grok) ---
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3

# Optional defaults
# SYSTEM_PROMPT=You are a helpful assistant.

# --- Memory (SQLite short-term history) ---
# SESSION_ID=default
# MEMORY_DB_PATH=./data/memory.db
# MEMORY_HISTORY_LIMIT=50

# --- Compression (Milestone 1 realtime) ---
# COMPRESSION_THRESHOLD=20
# COMPRESSION_KEEP_RECENT=8
# COMPRESSION_MAX_SUMMARY_CHARS=1500
# COMPRESSION_DISABLED=false
