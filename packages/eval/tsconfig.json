{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["../orchestrator/node_modules/@types"]
  },
  "include": [
    "src/cost.ts",
    "src/assertions.ts",
    "src/types.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
