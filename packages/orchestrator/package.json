{
  "name": "@workflows/orchestrator",
  "version": "0.1.0",
  "description": "Thin orchestrator glue — local Ollama + frontier Grok, wires Workflows layer packages",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "serve": "tsx src/integration/serverMain.ts",
    "ui": "tsx src/ui/web/main.ts",
    "knowledge:migrate": "tsx scripts/migrate-knowledge-postgres.ts",
    "knowledge:test:postgres": "tsx scripts/integration-knowledge-postgres.ts",
    "knowledge:test:canonical": "tsx scripts/integration-knowledge-canonical.ts",
    "knowledge:test:lineage": "tsx scripts/integration-knowledge-lineage.ts",
    "knowledge:test:vector": "tsx scripts/integration-knowledge-vector.ts",
    "knowledge:test:graph": "tsx scripts/integration-knowledge-graph.ts",
    "knowledge:test:hybrid": "tsx scripts/integration-knowledge-hybrid.ts",
    "knowledge:test:agent": "tsx scripts/integration-knowledge-agent.ts",
    "knowledge:agent": "tsx scripts/run-knowledge-agent.ts",
    "knowledge:background": "tsx scripts/run-background-cognition.ts",
    "knowledge:projections": "tsx scripts/reconcile-knowledge-projections.ts",
    "knowledge:projections:rebuild": "tsx scripts/reconcile-knowledge-projections.ts rebuild",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/run-eval.ts",
    "test:voice": "npm run test:voice:compat && npm run test:voice:live",
    "test:voice:compat": "node --require ./scripts/tsx-bootstrap.cjs --import tsx scripts/smoke-voice.ts",
    "test:voice:live": "node --require ./scripts/tsx-bootstrap.cjs --import tsx scripts/smoke-voice-live.ts",
    "test:voice:microphone": "node --require ./scripts/tsx-bootstrap.cjs --import tsx scripts/manual-voice-microphone.ts",
    "voice:live": "node --require ./scripts/tsx-bootstrap.cjs --import tsx scripts/live-voice.ts",
    "test:cc:source": "node --require ./scripts/tsx-bootstrap.cjs --import tsx scripts/smoke-experience.ts",
    "test:cc:lineage": "node --require ./scripts/tsx-bootstrap.cjs --import tsx scripts/integration-knowledge-lineage.ts",
    "test:cc:activation": "node --require ./scripts/tsx-bootstrap.cjs --import tsx scripts/smoke-capability-activation.ts",
    "test:cc:operational": "node --require ./scripts/tsx-bootstrap.cjs --import tsx scripts/smoke-continuous-cognition.ts",
    "test:cc:representation": "node --require ./scripts/tsx-bootstrap.cjs --import tsx scripts/smoke-representation-acquisition.ts",
    "test:cc:background": "node --require ./scripts/tsx-bootstrap.cjs --import tsx scripts/smoke-background-cognition.ts",
    "test:cc:observability": "node --require ./scripts/tsx-bootstrap.cjs --import tsx scripts/smoke-continuous-cognition-observability.ts",
    "test:cc": "node --require ./scripts/tsx-bootstrap.cjs --import tsx scripts/run-cc-eval.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@workflows/agents": "file:../agents",
    "@workflows/compression": "file:../compression",
    "@workflows/embeddings": "file:../embeddings",
    "@workflows/eval": "file:../eval",
    "@workflows/knowledge": "file:../knowledge",
    "@workflows/memory": "file:../memory",
    "@workflows/models": "file:../models",
    "@workflows/observability": "file:../observability",
    "@workflows/policy": "file:../policy",
    "@workflows/proactive": "file:../proactive",
    "@workflows/retrieval": "file:../retrieval",
    "@workflows/structured": "file:../structured",
    "@workflows/tools": "file:../tools",
    "@workflows/voice": "file:../voice",
    "@workflows/workspace": "file:../workspace",
    "better-sqlite3": "^13.0.2",
    "cytoscape": "^3.33.1"
  }
}
