# --- Local (Ollama CLI) ---
# Use a small model on weak machines (laptop). Override anytime.
OLLAMA_MODEL=llama3.2:3b
# Optional: path to ollama binary if not on PATH
# OLLAMA_BIN=ollama

# --- Frontier (xAI Grok) ---
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3

# Optional defaults
# SYSTEM_PROMPT=You are a helpful assistant.

# --- Memory (SQLite short-term history) ---
# SESSION_ID=default
# MEMORY_DB_PATH=./data/memory.db
# MEMORY_HISTORY_LIMIT=50

# --- Long-term memory (Milestone 3A) — no personal data in git ---
# LONGTERM_DB_PATH=./data/longterm.db
# Or store outside the repo:
# PERSONAL_CONTEXT_DIR=/path/outside/repo
# LONGTERM_AUTO_INJECT=false
# LONGTERM_INJECT_MAX_CHARS=1500
# LONGTERM_INJECT_LIMIT=5
# LONGTERM_DISABLED=false

# --- Knowledge model (Milestone 11–13) — semantic graph; no personal data in git ---
# KNOWLEDGE_DB_PATH=./data/knowledge.db
# Or under PERSONAL_CONTEXT_DIR/knowledge.db when set
# Register knowledge_* tools (also needs TOOLS_ENABLED for tool loop):
# KNOWLEDGE_TOOLS_ENABLED=false
# Optional compact neighborhood / project-status into model context (default off):
# KNOWLEDGE_INJECT_ENABLED=false
# KNOWLEDGE_INJECT_MAX_CHARS=2000
# KNOWLEDGE_INJECT_HOPS=1
# Default workspaceId on accept/ensure (else active workspace id from --workspace):
# KNOWLEDGE_DEFAULT_WORKSPACE_ID=

# --- Proactivity (Milestone 3B) — suggestions only, default off ---
# PROACTIVE_ENABLED=false
# PROACTIVE_MAX=3
# PROACTIVE_USE_MODEL=false
# PROACTIVE_MIN_CONFIDENCE=0.45
# PROACTIVE_LOCALE=nb

# --- Multi-agent pipeline (Milestone 3C) — use --pipeline / /pipeline; default off ---
# AGENTS_PIPELINE_ENABLED=false

# --- Embeddings / semantic memory (Milestone 4) — default off ---
# EMBEDDINGS_ENABLED=false
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# VECTOR_DB_PATH=./data/vectors.db
# EMBEDDINGS_MIN_SCORE=0.3
# EMBEDDING_TIMEOUT_MS=60000
# Linear scan over SQLite vectors is intentional for small N (no ANN index yet).

# --- Compression (Milestone 1 realtime) ---
# COMPRESSION_THRESHOLD=20
# COMPRESSION_KEEP_RECENT=8
# COMPRESSION_MAX_SUMMARY_CHARS=1500
# COMPRESSION_DISABLED=false

# --- Retrieval (Milestone 1 minimal keyword) ---
# RETRIEVAL_LIMIT=4
# RETRIEVAL_MAX_CHARS=2000
# RETRIEVAL_MAX_CHUNK_CHARS=600
# RETRIEVAL_CONTEXT_DIR=../context
# RETRIEVAL_DISABLED=false

# --- Workspace / integration (Milestone 5 + 9) ---
# WORKSPACE_ROOT=.
# Session ids stored as ws:<workspaceId>:<logical> unless:
# SESSION_NAMESPACE=false
# Optional project-scoped long-term DB under the workspace:
# LONGTERM_PROJECT_SCOPED=false
# LONGTERM_PROJECT_DB=.orchestrator/longterm.db
# INTEGRATION_HTTP_PORT=8787
# INTEGRATION_HTTP_TOKEN=

# --- Web UI (Milestone 6) — npm run ui ---
# UI_HOST=127.0.0.1
# UI_PORT=8787
# SESSION_ID=ui-default

# --- Compute policy (Milestone 7) — default off = router-only ---
# POLICY_ENABLED=false
# POLICY_DEFAULT_TIER=local
# POLICY_SESSION_TOKEN_CAP=
# POLICY_DAILY_USD_CAP=
# POLICY_MID_MODEL=
# MID_BASE_URL=
# MID_API_KEY=
# POLICY_MID_INPUT_PER_M=0.4
# POLICY_MID_OUTPUT_PER_M=0.8

# --- Observability (Milestone 8) — JSONL under data/logs/ ---
# OBS_ENABLED=true
# OBS_LOG_PATH=./data/logs/orchestrator.jsonl
# OBS_LOG_PROMPTS=false
# OBS_STDERR=false
# OBS_VERBOSE=false

# --- Tools (Milestone 2) ---
# TOOL_WORKSPACE_ROOT=.
# TOOL_READ_MAX_BYTES=262144
# TOOL_WRITE_MAX_BYTES=262144
# TOOL_COMMAND_TIMEOUT_MS=15000
# TOOL_SCRIPT_ROOTS=scripts
# TOOLS_DISABLED=false
# Phase B model tool-loop (default off)
# TOOLS_ENABLED=false
# TOOLS_MAX_STEPS=5
# Phase C extras / web search (off by default)
# TOOL_EXTRA_MODULES=./examples/extra-tools/echoTool.ts
# WEB_SEARCH_ENABLED=false
# WEB_SEARCH_ENDPOINT=
# WEB_SEARCH_API_KEY=

